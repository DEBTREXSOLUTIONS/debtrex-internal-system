# ─── DEBTREX INTERNAL SYSTEM ENVIRONMENT VARIABLES ───
# Copy this file to .env.local and fill in your values

# Supabase (Database + Auth) — get from supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# JWT Secret — generate with: openssl rand -base64 32
JWT_SECRET=replace_with_random_32_char_string

# Google Drive API — get from console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-master-folder-id

# Resend (Email) — get from resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=DEBTREX <noreply@yourdomain.com>

# Twilio (Click-to-Call) — paid account configuration
# See DEBTREX-Twilio-Setup-Guide.docx for setup
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Browser-based calling (Voice SDK) — required for in-browser calls
# See DEBTREX-Browser-Calling-Setup-Guide.docx for setup
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-api-secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: a different number to display as caller ID
TWILIO_CALLER_ID=
# Optional: set to "false" to disable answering machine detection
TWILIO_ENABLE_AMD=true

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=DEBTREX SOLUTIONS
