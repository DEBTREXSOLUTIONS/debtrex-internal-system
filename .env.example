# ─── DEBTREX INTERNAL SYSTEM ENVIRONMENT VARIABLES ───
# Copy this file to .env.local and fill in your values

# Supabase (Database + Auth) — get from supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# JWT Secret — generate with: openssl rand -base64 32
JWT_SECRET=replace_with_random_32_char_string

# Google Drive API — get from console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-master-folder-id

# Resend (Email) — get from resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=DEBTREX <noreply@yourdomain.com>

# Twilio (Click-to-Call) — get from twilio.com (see TWILIO-SETUP-GUIDE.docx)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=DEBTREX SOLUTIONS
